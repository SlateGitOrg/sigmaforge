# sigmaforge - one entry point for every gate and artefact.
UV ?= uv
RUN := $(UV) run --frozen
SIGMAHQ := third_party/sigmahq/rules
EXAMPLES := examples/rules
EVENTS := examples/events/windows.jsonl

.PHONY: help install check fmt fmt-check lint type test fuzz mutants bench demo \
        compile-report golden fetch-sigmahq clean

help:
	@echo "make check           format-check + lint + mypy --strict + tests with coverage gate"
	@echo "make demo            offline end-to-end demo on bundled rules and events"
	@echo "make compile-report  regenerate docs/sigmahq-compile-report.md (pinned SigmaHQ subset)"
	@echo "make mutants         seeded-bug kill rate of the differential tests"
	@echo "make fuzz            long Hypothesis run (5000 examples per property)"
	@echo "make bench           compile and matching throughput"
	@echo "make fetch-sigmahq   re-download the pinned subset and verify checksums (network)"

install:
	$(UV) sync --frozen

fmt:
	$(RUN) ruff format src tests scripts

fmt-check: install
	$(RUN) ruff format --check src tests scripts

lint: install
	$(RUN) ruff check src tests scripts

type: install
	$(RUN) mypy

test: install
	$(RUN) pytest --cov --cov-report=term

check: fmt-check lint type test

fuzz: install
	HYPOTHESIS_PROFILE=fuzz $(RUN) pytest -q tests/test_differential.py tests/test_condition.py \
		tests/test_regexdialect.py tests/test_sigmastr.py tests/test_modifiers.py

mutants: install
	$(RUN) python scripts/mutation_check.py
	$(RUN) python scripts/mutation_check.py --whole-rule-only
	$(RUN) python scripts/mutation_check.py --pinned-examples

bench: install
	$(RUN) python scripts/bench.py

golden: install
	UPDATE_GOLDEN=1 $(RUN) pytest -q tests/test_golden.py

compile-report: install
	$(RUN) sigmaforge report $(SIGMAHQ) -o docs/sigmahq-compile-report.md \
		--heading "SigmaHQ compile report" \
		--preamble "Generated by \`make compile-report\` from the 200-rule subset of SigmaHQ release r2026-07-01 (commit 552f3fe) pinned in third_party/sigmahq/MANIFEST.json, with each backend's default pipeline."

fetch-sigmahq:
	$(RUN) python scripts/fetch_sigmahq.py

demo: install
	@echo "== 1. built-in pipelines"
	$(RUN) sigmaforge pipelines
	@echo
	@echo "== 2. one rule, compiled AST (after the sentinel-windows pipeline)"
	$(RUN) sigmaforge ast -p sentinel-windows $(EXAMPLES)/proc_office_child_shell.yml
	@echo
	@echo "== 3. the same rule for all four backends"
	@for t in splunk eql kql sql; do \
		echo "-- $$t"; $(RUN) sigmaforge compile -t $$t $(EXAMPLES)/proc_office_child_shell.yml || exit 1; \
	done
	@echo "== 4. sigmaforge compile -t kql $(EXAMPLES)/  (failures are reported, not hidden)"
	$(RUN) sigmaforge compile -t kql --allow-failures $(EXAMPLES)/
	@echo "== 5. reference evaluator on the demo events"
	$(RUN) sigmaforge eval $(EXAMPLES)/proc_encoded_powershell.yml $(EVENTS)
	@echo
	@echo "== 6. execute the SQL backend in SQLite and cross-check against the evaluator"
	$(RUN) sigmaforge sql-run $(EXAMPLES) -e $(EVENTS)
	@echo
	@echo "== 7. compile coverage over the pinned SigmaHQ subset (summary)"
	$(RUN) sigmaforge report $(SIGMAHQ) -o /dev/null

clean:
	rm -rf .pytest_cache .mypy_cache .ruff_cache .hypothesis .coverage htmlcov dist
